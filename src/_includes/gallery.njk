---
layout: base.njk
templateEngineOverride: njk
title: Gallery | {{ business.name }}
---
<section class="relative overflow-hidden bg-[#2f2f2f] text-white">
    <div class="max-w-5xl mx-auto px-6 py-24 md:py-32 text-center">
        <p class="uppercase tracking-[0.15em] text-xs text-brand-primary font-semibold mb-4">
            {{ business.serviceArea }} Projects
        </p>
        <h1 class="font-display text-4xl sm:text-5xl md:text-6xl font-black leading-tight mb-6">
            {{ title or "Our Work" }}
        </h1>
        <p class="max-w-2xl mx-auto text-base md:text-lg text-gray-300 leading-relaxed">
            {{ description or "" }}
        </p>
    </div>
</section>
<section class="bg-white py-16 border-t border-gray-100">
    <div class="max-w-3xl mx-auto px-6 text-center">
        <p class="text-gray-600 leading-relaxed text-base md:text-lg">
            A selection of recent projects completed across {{ business.serviceArea }}.
        </p>
    </div>
</section>
{% if site.galleryStyle == "video" %}
<section class="bg-[#f7f7f7] py-20">
    <div class="max-w-6xl mx-auto px-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for item in gallery %}
            <button class="group text-left video-trigger focus:outline-none" data-src="{{ item.src or item.image }}" data-type="{{ item.type }}" data-alt="{{ item.alt }}">
                <div class="relative overflow-hidden rounded-2xl bg-gray-200 aspect-square">
                {% if item.type == "video" %}
                <video autoplay muted loop playsinline poster="{{ item.poster }}" class="w-full h-full object-cover transition duration-500 group-hover:scale-105">
                    <source src="{{ item.src }}" type="video/mp4">
                </video>
                <div class="absolute inset-0 flex items-center justify-center bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-14 h-14 text-white" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M8 5v14l11-7z"/>
                    </svg>
                </div>
                {% else %}
                {% image item.image, item.alt, "(max-width: 768px) 100vw, 33vw", "w-full h-full object-cover transition duration-500 group-hover:scale-105" %}
                {% endif %}
                </div>
                <div class="pt-4">
                    <p class="text-xs uppercase tracking-[0.12em] text-brand-primary font-semibold mb-1">{{ item.category }}</p>
                    <p class="text-sm text-gray-500">{{ item.location }}</p>
                </div>
            </button>
        {% endfor %}
        </div>
    </div>
</section>
<div id="video-modal" class="hidden fixed inset-0 z-[100] items-center justify-center bg-black/90 p-4">
    <button id="video-modal-close" class="absolute top-6 right-6 text-white text-4xl leading-none hover:text-brand-primary transition-colors" aria-label="Close">&times;</button>
    <div class="w-full max-w-4xl">
        <video id="video-modal-player" controls autoplay class="w-full rounded-2xl shadow-2xl max-h-[85vh]"></video>
        <img id="video-modal-image" class="w-full rounded-2xl shadow-2xl max-h-[85vh] object-contain hidden" src="" alt="">
    </div>
</div>
<script>
document.addEventListener("DOMContentLoaded", () => {
  const modal = document.getElementById("video-modal");
  const player = document.getElementById("video-modal-player");
  const imageEl = document.getElementById("video-modal-image");
  const closeBtn = document.getElementById("video-modal-close");
  document.querySelectorAll(".video-trigger").forEach(btn => {
    btn.addEventListener("click", () => {
      const src = btn.dataset.src;
      const type = btn.dataset.type;
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      if (type === "video") {
        player.src = src;
        player.classList.remove("hidden");
        imageEl.classList.add("hidden");
      } else {
        imageEl.src = src;
        imageEl.classList.remove("hidden");
        player.classList.add("hidden");
        player.pause();
      }
    });
  });
  closeBtn.addEventListener("click", () => {
    modal.classList.add("hidden");
    modal.classList.remove("flex");
    player.pause();
    player.src = "";
  });
});
</script>
{% else %}
<section class="bg-[#f7f7f7] py-20">
    <div class="max-w-6xl mx-auto px-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for item in gallery %}
            <button class="group text-left lightbox-trigger focus:outline-none" data-full="{{ item.image }}" data-alt="{{ item.alt }}">
                <div class="overflow-hidden rounded-2xl bg-gray-200 cursor-pointer">
                    {% image item.image, item.alt, "(max-width: 768px) 100vw, 33vw", "w-full aspect-square object-cover transition duration-500 group-hover:scale-105" %}
                </div>
                <div class="pt-4">
                    <p class="text-xs uppercase tracking-[0.12em] text-brand-primary font-semibold mb-1">{{ item.category }}</p>
                    <p class="text-sm text-gray-500">{{ item.location }}</p>
                </div>
            </button>
        {% endfor %}
        </div>
    </div>
</section>
<div id="lightbox" class="fixed inset-0 z-50 hidden flex-col items-center justify-center bg-black/90 p-4 transition-opacity duration-300 opacity-0">
    <button id="lightbox-close" class="absolute top-6 right-6 text-white/70 hover:text-white p-2 focus:outline-none" aria-label="Close Lightbox">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
    </button>
    <div class="max-w-5xl max-h-[85vh] flex items-center justify-center">
        <img id="lightbox-img" src="" alt="" class="max-w-full max-h-[80vh] object-contain rounded shadow-2xl select-none">
    </div>
    <p id="lightbox-caption" class="mt-4 text-sm tracking-wide text-gray-300 font-medium px-4 text-center"></p>
</div>
{% endif %}
<section class="bg-brand-primary text-white py-20">
    <div class="max-w-4xl mx-auto px-6 text-center">
        <h2 class="text-4xl md:text-5xl font-black leading-tight mb-6">
            Need Our Services?
        </h2>
        <p class="max-w-2xl mx-auto text-base md:text-lg text-white/85 leading-relaxed mb-10">
            Contact {{ business.name }} today for a free inspection and estimate.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/contact/"
                class="inline-flex items-center justify-center bg-white text-brand-primary font-black py-4 px-8 rounded-full hover:bg-gray-100 transition">
                Request a Free Estimate
            </a>
            <a href="tel:{{ business.phone }}"
                class="inline-flex items-center justify-center border-2 border-white/40 text-white font-bold py-4 px-8 rounded-full hover:bg-white/10 transition">
                {{ business.phoneDisplay }}
            </a>
        </div>
    </div>
</section>